{
  "name": "Homepage Devcontainer",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bullseye",
  
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": {
      "label": "Astro",
      "onAutoForward": "openBrowser"
    }
  },

  "remoteUser": "node",

  "postCreateCommand": "npm install && npm install -g @githubnext/github-copilot-cli",

  "customizations": {
    "vscode": {
      "extensions": [
        "astro-build.astro-vscode",
        "dbaeumer.vscode-eslint",
        "ritwickdey.liveserver",
        "github.copilot",
        "github.copilot-chat"
      ]
    }
  }
}