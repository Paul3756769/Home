---
import Starfield from "../components/Starfield.astro";
import "../styles/global.css";
const { page_title } = Astro.props;
---
<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{page_title}</title>
    </head>
    <body>
        <!-- Starfield component in the background -->
        <Starfield />

        <!-- Base content wrapper: occupies the full viewport. -->
        <div class="content-wrapper">
            <slot />
        </div>
    </body>
</html>

<style>
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
    }

    /* Ensure the wrapper spans the entire page */
    .content-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
        /* Layouts that include header/footer or main can override alignment */
        justify-content: center;
        align-items: center;
        box-sizing: border-box;
    }
</style>
