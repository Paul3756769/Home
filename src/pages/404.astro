---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "404";
const img_url = "/Homepage/404.gif";
//const img_url = "/Homepage/tng.gif";
//const img_url = "/Homepage/dumb-stupid.gif";
//const img_url = "/Homepage/monkey_pc.gif";
const alt_text = "404";
---
<BaseLayout page_title={title}>
  <div class="content-box">
    <h1>Page does not exist</h1>
    <img src={img_url} alt={alt_text} />
    <p>Sorry for that.</p>
  </div>
</BaseLayout>

<style>
  .content-box {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  .content-box h1,
  .content-box p,
  .content-box img {
    position: relative;
    z-index: 1;
  }
</style>

