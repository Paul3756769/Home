---
import BaseLayout from "../layouts/BaseLayout.astro";
const title = "404";
const img_url = "/Homepage/404.gif";
//const img_url = "/Homepage/tng.gif";
//const img_url = "/Homepage/dumb-stupid.gif";
//const img_url = "/Homepage/monkey_pc.gif";
const alt_text = "404";
---
<BaseLayout page_title={title}>
  <div class="content-wrapper">
    <center>
      <h1>Page does not exist</h1>
      <img src={img_url} alt={alt_text} />
      <p>Sorry for that.</p>
    </center>
  </div>
</BaseLayout>

<style>
  .content-wrapper {
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }
  
  h1, p, img {
    position: relative;
    z-index: 1;
  }
</style>

