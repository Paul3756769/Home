---
import BaseLayout from "../layouts/BaseLayout.astro";

const page_title = "Blog";
---

<BaseLayout page_title={page_title}>
  <main class="page-wrapper">
    <h1>Blog</h1>
    <p>Pick an article:</p>
    <ul>
      <li><a href="/DemoBlog">Demo Blog Post</a></li>
    </ul>
  </main>
</BaseLayout>

<style>
  .page-wrapper {
    max-width: 720px;
    margin: 3rem auto;
    padding: 0 1.25rem;
    box-sizing: border-box;
  }

  h1 {
    margin-top: 0;
  }
</style>
