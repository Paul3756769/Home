---
import BaseLayout from "../layouts/BaseLayout.astro";
const page_title = "Home";
---
<BaseLayout page_title={page_title}>
  <div class="content-wrapper">
    <div class="avatar-wrap" aria-hidden="true">
      <img id="profile-avatar" src="/favicon.svg" alt="" />
    </div>
    <div class="intro">
      <h1>Hi there! I am <span class="name-highlight">Paul</span></h1>
      <p>Press space :)</p>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const avatar = document.getElementById("profile-avatar");
    const wrapper = document.querySelector(".content-wrapper");
    if (!avatar || !wrapper) return;

    const useFallbackLayout = () => wrapper.classList.add("no-avatar");

    if (avatar.complete && avatar.naturalWidth === 0) {
      useFallbackLayout();
    }

    avatar.addEventListener("error", useFallbackLayout, { once: true });
  });
</script>

<style>

  .content-wrapper {
    position: relative;
    min-height: calc(100svh - var(--site-header-height));
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 1.35rem;
    padding: 1.25rem;
    box-sizing: border-box;
  }

  .avatar-wrap {
    width: 9rem;
    height: 9rem;
    align-self: center;
    margin-inline: auto;
    border-radius: 999px;
    overflow: hidden;
    border: 2px solid #3b4256;
    background: rgba(10, 14, 23, 0.65);
    display: grid;
    place-items: center;
  }

  .avatar-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .intro {
    text-align: center;
    width: min(92vw, 700px);
    align-self: center;
    margin-inline: auto;
  }

  .intro h1 {
    margin: 0;
  }

  .intro p {
    margin: 1rem 0 0;
  }

  .name-highlight {
    color: #878787;
  }

  .content-wrapper.no-avatar .avatar-wrap {
    display: none;
  }

  .content-wrapper.no-avatar {
    gap: 0.9rem;
  }

  @media (max-width: 640px) {
    .avatar-wrap {
      width: 12rem;
      height: 12rem;
    }
  }
  
</style>

