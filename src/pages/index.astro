---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
const page_title = "Home";
---
<BaseLayout page_title={page_title} show_nav={false}>
  <div class="content-wrapper">
    <div class="intro">
      <h1>Hi there! I am <span class="name-highlight">Paul</span></h1>
      <p>Press space :)</p>
    </div>
    <div class="home-nav-row">
      <SiteNav variant="inline" show_home={false} />
    </div>
  </div>
</BaseLayout>

<style>

  .content-wrapper {
    position: relative;
    height: 100vh;
    width: 100%;
    box-sizing: border-box;
  }

  .intro {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: min(92vw, 700px);
  }

  .home-nav-row {
    position: absolute;
    top: calc(50% + 5.25rem);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .name-highlight {
    color: #878787;
  }

  @media (max-width: 640px) {
    .home-nav-row {
      top: calc(50% + 6rem);
    }
  }
  
</style>

