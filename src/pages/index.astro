---
import BaseLayout from "../layouts/BaseLayout.astro";
const page_title = "Home";
---
<BaseLayout page_title={page_title}>
  <div class="content-wrapper">
    <center>
      <h1>Hi there! I am <span class="name-highlight">Paul</span></h1>
      <p>Press space :)</p>
      <p>Check out the <a href="/DemoBlog">demo blog post</a></p>
    </center>
  </div>
</BaseLayout>

<style>

  .content-wrapper {
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    box-sizing: border-box;
  }

  .name-highlight {
    color: #878787;
  }
  
</style>

