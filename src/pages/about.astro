---
import BaseLayout from "../layouts/BaseLayout.astro";

const page_title = "About Me";
---

<BaseLayout page_title={page_title}>
  <main class="page-wrapper">
    <h1>About Me</h1>
    <p>This is a placeholder page for future content.</p>
  </main>
</BaseLayout>

<style>
  .page-wrapper {
    max-width: 720px;
    margin: 3rem auto;
    padding: 0 1.25rem;
    box-sizing: border-box;
  }

  h1 {
    margin-top: 0;
  }
</style>
