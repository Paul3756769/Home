---
export interface Props {
  variant?: "header" | "inline";
  show_home?: boolean;
}

const { variant = "header", show_home = true } = Astro.props as Props;
const isHeader = variant === "header";
const navClass = isHeader ? "site-nav site-nav-header" : "site-nav site-nav-inline";
---

<nav class={navClass} aria-label="Site navigation">
  {isHeader ? (
    <>
      <div class="nav-group nav-left">
        <a href="/">Home</a>
      </div>
      <div class="nav-group nav-right">
        <a href="/blog">Blog</a>
        <a href="/about">About Me</a>
      </div>
    </>
  ) : (
    <>
      {show_home && <a href="/">Home</a>}
      <a href="/blog">Blog</a>
      <a href="/about">About Me</a>
    </>
  )}
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    font-size: 0.95rem;
    gap: 0.75rem;
  }

  .site-nav-header {
    width: 100%;
    justify-content: space-between;
  }

  .site-nav-inline {
    justify-content: center;
  }

  .nav-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-nav a {
    color: #d8d3cc;
    border: 1px solid #3b4256;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: #ffffff;
    border-color: #7a8fb3;
  }
</style>