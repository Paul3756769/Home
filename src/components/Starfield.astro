---
// Configurable parameters with defaults
export interface Props {
  starCount?: number;
  twinkleAmount?: number;
  colorVariety?: number;
  pointiness?: number;
  glowStrength?: number;
  backgroundOpacity?: number;
  twinkleSpeed?: number;
  twinkleSpeedVariation?: number;
  twinkleOpacityBase?: number;
  rngSeed?: number;
}

const {
  starCount = 500,
  twinkleAmount = 0.3,
  colorVariety = 0.1,
  pointiness = 0.9,
  glowStrength = 0.3,
  backgroundOpacity = 1.0,
  twinkleSpeed = 0.0005,
  twinkleSpeedVariation = 0.0005,
  twinkleOpacityBase = 0.6,
  rngSeed = 0
} = Astro.props as Props;
---

<div class="star-field" 
  data-star-count={starCount}
  data-twinkle-amount={twinkleAmount}
  data-color-variety={colorVariety}
  data-pointiness={pointiness}
  data-glow-strength={glowStrength}
  data-twinkle-speed={twinkleSpeed}
  data-twinkle-speed-variation={twinkleSpeedVariation}
  data-twinkle-opacity-base={twinkleOpacityBase}
  data-rng-seed={rngSeed}
  style={`--bg-opacity: ${backgroundOpacity};`}>
  <canvas id="starCanvas"></canvas>
</div>
  
<script is:inline>
  // Self-contained helpers

  function createSeededRandom(seed) {
    let state = seed;
    return () => {
      state = (state * 9301 + 49297) % 233280;
      return state / 233280;
    };
  }

  // resizeCanvas: sets canvas size and updates star absolute positions from stored percentages.
  // initStarsFn is a zero-arg function that will initialize `stars` if needed.
  function resizeCanvas(canvas, stars, initStarsFn) {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;

    if (stars.length > 0) {
      stars.forEach(star => {
        star.x = star.xPercent * canvas.width;
        star.y = star.yPercent * canvas.height;
      });
    } else {
      initStarsFn();
    }
  }

  // initStars: populates the provided `stars` array using a passed config object.
  function initStars(config, stars) {
    const {
      starCount, canvas, seedRandom,
      colorVariety, pointiness,
      twinkleSpeed, twinkleSpeedVariation
    } = config;

    stars.length = 0;

    for (let i = 0; i < starCount; i++) {
      const xPercent = seedRandom();
      const yPercent = seedRandom();
      const x = xPercent * canvas.width;
      const y = yPercent * canvas.height;

      const sizeRandom = seedRandom();
      let size;
      if (sizeRandom > 0.998) {
        size = 1.5 + seedRandom() * 1;
      } else if (sizeRandom > 0.98) {
        size = 0.8 + seedRandom() * 0.5;
      } else if (sizeRandom > 0.85) {
        size = 0.4 + seedRandom() * 0.3;
      } else {
        size = 0.1 + seedRandom() * 0.3;
      }

      const maxOpacity = 0.4 + seedRandom() * 0.6;
      const twinklePhase = seedRandom() * Math.PI * 2;
      const starTwinkleSpeed = twinkleSpeed + seedRandom() * twinkleSpeedVariation;

      let hue, saturation, lightness;
      const colorType = seedRandom();
      if (colorType > (1 - colorVariety * 0.3)) {
        hue = 0 + seedRandom() * 20;
        saturation = 30 + seedRandom() * 20;
        lightness = 80 + seedRandom() * 15;
      } else if (colorType > (1 - colorVariety * 0.6)) {
        hue = 200 + seedRandom() * 40;
        saturation = 30 + seedRandom() * 20;
        lightness = 80 + seedRandom() * 15;
      } else if (colorType > (1 - colorVariety)) {
        hue = 40 + seedRandom() * 20;
        saturation = 30 + seedRandom() * 20;
        lightness = 80 + seedRandom() * 15;
      } else {
        hue = 180 + seedRandom() * 60;
        saturation = 5 + seedRandom() * 25;
        lightness = 85 + seedRandom() * 15;
      }

      const color = `hsl(${hue}, ${saturation}%, ${lightness}%)`;
      const isPointStar = size < 1 && seedRandom() < pointiness;

      stars.push({
        xPercent, yPercent, x, y, size, maxOpacity, color, twinklePhase,
        twinkleSpeed: starTwinkleSpeed, isPointStar
      });
    }
  }

  // createAnimator: returns a controller with start() and stop() for the animation loop.
  function createAnimator(ctx, canvas, stars, options) {
    const { twinkleAmount, twinkleOpacityBase, glowStrength } = options;
    let animationId = null;
    let lastTime = 0;

    function frame(timestamp) {
      if (!lastTime) lastTime = timestamp;
      const deltaTime = timestamp - lastTime;
      lastTime = timestamp;

      ctx.fillStyle = '#000';
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      stars.forEach(star => {
        star.twinklePhase += star.twinkleSpeed * deltaTime;

        const twinkling = Math.max(twinkleOpacityBase, 1 - twinkleAmount);
        const twinkleFactor = twinkleAmount * Math.sin(star.twinklePhase);
        const opacity = star.maxOpacity * (twinkling + twinkleFactor);

        ctx.globalAlpha = opacity;

        if (star.isPointStar) {
          ctx.fillStyle = star.color;
          ctx.fillRect(star.x, star.y, 1, 1);
          if (star.size > 0.6) {
            ctx.fillRect(star.x - 1, star.y, 3, 1);
            ctx.fillRect(star.x, star.y - 1, 1, 3);
          }
        } else {
          ctx.beginPath();
          ctx.arc(star.x, star.y, star.size / 2, 0, Math.PI * 2);
          ctx.fillStyle = star.color;
          ctx.fill();

          if (star.size > 1.2 && glowStrength > 0) {
            const glowSize = star.size * 1.5 * glowStrength;
            const gradient = ctx.createRadialGradient(star.x, star.y, 0, star.x, star.y, glowSize);
            gradient.addColorStop(0, star.color);
            gradient.addColorStop(1, 'rgba(0,0,0,0)');

            ctx.beginPath();
            ctx.arc(star.x, star.y, glowSize, 0, Math.PI * 2);
            ctx.fillStyle = gradient;
            ctx.fill();
          }
        }

        ctx.globalAlpha = 1;
      });

      animationId = requestAnimationFrame(frame);
    }

    return {
      start() {
        if (animationId == null) animationId = requestAnimationFrame(frame);
      },
      stop() {
        if (animationId != null) {
          cancelAnimationFrame(animationId);
          animationId = null;
        }
      }
    };
  }

  let animator = null;
  let stars = [];
  let canvas = null;
  let ctx = null;
  let starfieldElement = null;
  let active = false;

  function setup() {
    try {
      canvas = document.getElementById('starCanvas');
      if (!canvas) {
        console.error('Star canvas element not found');
        return;
      }

      ctx = canvas.getContext('2d');
      if (!ctx) {
        console.error('Could not get 2d context from canvas');
        return;
      }

      starfieldElement = document.querySelector('.star-field');
      const starCount = parseInt(starfieldElement.dataset.starCount || '1500');
      const twinkleAmount = parseFloat(starfieldElement.dataset.twinkleAmount || '0.3');
      const colorVariety = parseFloat(starfieldElement.dataset.colorVariety || '0.1');
      const pointiness = parseFloat(starfieldElement.dataset.pointiness || '0.9');
      const glowStrength = parseFloat(starfieldElement.dataset.glowStrength || '0.3');
      const twinkleSpeed = parseFloat(starfieldElement.dataset.twinkleSpeed || '0.0003');
      const twinkleSpeedVariation = parseFloat(starfieldElement.dataset.twinkleSpeedVariation || '0.0005');
      const twinkleOpacityBase = parseFloat(starfieldElement.dataset.twinkleOpacityBase || '0.6');
      const rngSeed = starfieldElement.dataset.rngSeed ? parseInt(starfieldElement.dataset.rngSeed) : null;

      const seedRandom = rngSeed !== null ? createSeededRandom(rngSeed) : Math.random;

      stars = [];

      const initStarsBound = () => initStars({
        starCount, canvas, seedRandom,
        colorVariety, pointiness, twinkleSpeed, twinkleSpeedVariation
      }, stars);

      // initial sizing and listeners
      resizeCanvas(canvas, stars, initStarsBound);
      window.addEventListener('resize', () => resizeCanvas(canvas, stars, initStarsBound));

      animator = createAnimator(ctx, canvas, stars, { twinkleAmount, twinkleOpacityBase, glowStrength });

      initStarsBound();
      animator.start();
      active = true;
    } catch (error) {
      console.error('Error in starfield animation:', error);
    }
  }

  function teardown() {
    try {
      if (animator) {
        animator.stop();
        animator = null;
      }
      if (canvas && ctx) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
      stars = [];
      canvas = null;
      ctx = null;
      starfieldElement = null;
      active = false;
    } catch (error) {
      console.error('Error during starfield teardown:', error);
    }
  }

  // Wait for DOM to fully load
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = () => {
      if (active) {
        teardown();
      } else {
        setup();
      }
    };

    const keyHandler = (event) => {
      if (event.code === 'Space' || event.key === ' ') {
        event.preventDefault();
        toggle();
      }
    };

    document.addEventListener('toggle-starfield', toggle);
    document.addEventListener('keydown', keyHandler);

    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('toggle-starfield', toggle);
      document.removeEventListener('keydown', keyHandler);
      teardown();
    });
  });
</script>

<style>
  /* Starfield styles */
  .star-field {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -99;
    overflow: hidden;
    pointer-events: none; 
    background-color: rgba(0, 0, 0, var(--bg-opacity, 1));
  }
  
  #starCanvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>